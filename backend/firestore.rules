rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Helper Functions --------
    function isOwner() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // -------- Users Collection --------
    match /users/{userId} {
      // Allow authenticated users to see profiles (necessary for finding owners)
      allow read, list: if request.auth != null;
      allow create: if isSelf(userId);
      allow update: if (isSelf(userId) && !request.resource.data.diff(resource.data).changedKeys().hasAny(['role']))
                    || (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyaltyPoints', 'lastVisitDate']));
      
      // CRITICAL: Notifications subcollection
      match /notifications/{notificationId} {
        // Any authenticated user can CREATE a notification entry (e.g., Farmer notifies Owner)
        allow create: if request.auth != null;
        // Only the recipient can READ, UPDATE, or DELETE their own notifications
        allow read, list, update, delete: if isSelf(userId);
      }

      match /cart/{itemId} { allow read, write: if isSelf(userId); }
      match /advisory_reads/{readId} { allow read, list, write: if isSelf(userId); }
    }

    match /approved_owners/{phone} { allow read: if true; }

    match /categories/{id} { allow read, list: if true; allow write: if isOwner(); }

    match /products/{id} {
      allow read, list: if true;
      allow write: if isOwner();
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastSoldDate']);
    }

    match /banners/{id} { allow read, list: if true; allow write: if isOwner(); }
    match /advisories/{id} { allow read, list: if true; allow write: if isOwner(); }

    match /orders/{id} {
      allow create: if request.auth != null;
      allow read, list, update: if request.auth != null;
      allow delete: if false;
    }

    match /creditLedger/{id} {
       allow read, list, write: if request.auth != null;
    }
    
    match /crops/{id} { allow read, write: if request.auth != null; }
    match /advisory_messages/{id} { allow read, list: if request.auth != null; allow write: if isOwner(); }
    match /aadhar_limits/{aadharId} { allow read, write: if request.auth != null; }
    match /aadhar_details/{aadharId} { allow read, write: if request.auth != null; }
    match /shop_settings/{id} {
      allow read, list: if request.auth != null;
      allow create, update, delete: if isOwner();
    }

    match /feedbacks/{id} {
      allow read, list: if true;
      allow create: if request.auth != null;
      allow update: if isOwner();
    }

    match /crop_guides/{id} {
      allow read, list: if true;
      allow write: if isOwner();
    }

    match /common_diseases/{id} {
      allow read, list: if true;
      allow write: if isOwner();
    }

    match /{document=**} { allow read, write: if false; }
  }
}